# Server only. Do not prefix these with VITE_ or paste credentials into Git.
LUMAFIELD_DEMO_ACCESS_TOKEN=
LUMAFIELD_AGENT_TOOL_KEY=
LUMAFIELD_SESSION_SIGNING_KEY=
LUMAFIELD_ELEVENLABS_API_KEY=
LUMAFIELD_AGENT_ID=
LUMAFIELD_VISION_API_KEY=
LUMAFIELD_VISION_MODEL=gpt-5.5
LUMAFIELD_AIRTABLE_TOKEN=
LUMAFIELD_AIRTABLE_BASE_ID=
LUMAFIELD_AIRTABLE_TABLE_NAME=LumaField Actions
LUMAFIELD_DATA_DIR=./data
# Provisioning only; public HTTPS endpoint reachable by ElevenLabs.
LUMAFIELD_PUBLIC_API_URL=
# Optional: Google (Gemini) as the vision provider instead of OpenAI.
LUMAFIELD_VISION_PROVIDER=openai
LUMAFIELD_GOOGLE_API_KEY=
LUMAFIELD_GOOGLE_VISION_MODEL=gemini-3-flash-preview
# Optional: OpenRouter as a single-key gateway to any vision provider.
LUMAFIELD_OPENROUTER_API_KEY=
LUMAFIELD_OPENROUTER_MODEL=openai/gpt-5.5
