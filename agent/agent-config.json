{
  "name": "LumaField - field asset reconciliation",
  "conversation_config": {
    "agent": {
      "first_message": "Hi. I can answer a question about inspection history or start a new inspection. What do you need?",
      "language": "en",
      "prompt": {
        "llm": "gpt-5.6-sol",
        "prompt": "See agent/system-prompt.md in this repository. Keep the full prompt synchronized when provisioning.",
        "temperature": 0.1,
        "reasoning_effort": "none"
      }
    },
    "tts": {
      "model_id": "eleven_flash_v2"
    },
    "turn": {
      "turn_timeout": 30,
      "turn_eagerness": "patient",
      "silence_end_call_timeout": -1
    },
    "conversation": {
      "max_duration_seconds": 1200
    }
  },
  "provisioning": {
    "tools_manifest": "agent/tools.json",
    "workflow_manifest": "agent/workflow.json",
    "knowledge_base_manifest": "agent/knowledge-base.json",
    "testing_manifest": "agent/tests.json",
    "analysis_manifest": "agent/analysis.json",
    "post_call_webhook": "/v1/webhooks/elevenlabs/post-call",
    "requires_public_https": true,
    "requires_secret_dynamic_variables": ["secret__lumafield_session"],
    "workspace_secrets": ["LumaField Agent Tool Key"],
    "platform_injected_variables": ["system__conversation_id"]
  }
}
